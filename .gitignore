# Dependencies
node_modules/

# Bundled portable Node.js runtime (carried on the USB stick, not in git —
# ~150MB of binaries; download separately via tools/README.md if missing)
tools/node-portable/

# Build output
client/dist/

# Runtime data (SQLite database)
server/data/*.db
server/data/*.db-journal
server/data/*.db-wal
server/data/*.db-shm

# User-uploaded content (music, backgrounds, logos)
server/uploads/music/*
server/uploads/backgrounds/*
server/uploads/logos/*
!server/uploads/music/.gitkeep
!server/uploads/backgrounds/.gitkeep
!server/uploads/logos/.gitkeep

# Firebase credentials (never commit)
server/firebase-service-account*.json*
.env
.env.local

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.local
